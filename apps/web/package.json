{
  "name": "@memo/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "esbuild scripts/local-api.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/local-api/server.mjs --log-level=warning && node node_modules/.cache/local-api/server.mjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@memo/core": "*"
  },
  "devDependencies": {
    "@memo/memo-api": "*",
    "vite": "^8.3.1"
  }
}
