# 配置スクリプト(npm run deploy:web / npm run clean:web)の配置先(SPEC 10.6)。
# このファイルをリポジトリのルートの .env にコピーして値を入れる。.env は Git 管理外。
# prod など別の配置先は .env.prod のように別のファイルに置き、--env-file で渡す
#
# Object Storage の namespace(oci os ns get で確認できる)
OCI_NAMESPACE=<namespace>
# 静的ファイルを置くバケットの名前(Terraform で作ったもの)
OCI_BUCKET=<bucket-name>
# OCI CLI のプロファイル(~/.oci/config のセクション名)
OCI_PROFILE=<profile>
# リージョンの識別子(例: ap-tokyo-1)
OCI_REGION=<region>
