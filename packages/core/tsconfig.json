{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // core は API(Node.js)とフロントエンド(ブラウザ)の両方で使う。
    // 使うグローバル(atob / btoa / TextEncoder)は両方にあるので、型は Node.js のものを使って DOM は入れない。
    // ブラウザの型はフロントエンドの tsconfig で検査する
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": ["src"]
}
