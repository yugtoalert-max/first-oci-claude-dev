{
  "permissions": {
    "deny": [
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(terraform -chdir=* apply *)",
      "Bash(terraform -chdir=* destroy *)",
      "Bash(docker push *)",
      "Bash(npm run deploy:web *)",
      "Bash(npm run clean:web *)",
      "Read(**/*.tfvars)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.*)",
      "Read(**/*.tfplan)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.stg)",
      "Read(**/.env.prod)",
      "Read(**/*.pem)",
      "Read(~/.oci/**)"
    ],
    "ask": [
      "Edit(/.claude/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "excludedCommands": [
      "terraform -chdir=infra/envs/* plan *",
      "terraform -chdir=infra/envs/* init *",
      "terraform fmt *",
      "gh pr *"
    ],
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "registry.npmjs.org",
        "registry.terraform.io",
        "releases.hashicorp.com"
      ],
      "allowUnixSockets": [
        "~/.colima/default/docker.sock"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.ts\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-paths.ts\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify-on-stop.ts\"",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
